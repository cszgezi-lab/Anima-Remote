# Copy this file to deploy/.env.  Never commit deploy/.env.

# Host-side listener.  127.0.0.1 is intentional: Tailscale Serve can proxy
# this local port and expose only its HTTPS MagicDNS endpoint to the Tailnet.
ANIMA_BIND_IP=127.0.0.1
ANIMA_PORT=18000

# Optional image/container names for local upgrades.
ANIMA_IMAGE=anima-remote:local
ANIMA_CONTAINER_NAME=anima-remote

# Match the Linux account that owns deploy/data (`id -u` and `id -g`).
ANIMA_UID=1000
ANIMA_GID=1000

# List the exact WebView origins that the extension sends in Origin.  Keep
# this narrow; these are not authentication credentials.  Add an origin only
# after confirming it in the TauriTavern network log.
ANIMA_CORS_ORIGINS=null,tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost,https://localhost

# Replace provider.example with the exact public hostnames used by the
# configured embedding, rerank, and summary providers.  Private targets and
# cleartext HTTP remain disabled by default.
ANIMA_OUTBOUND_ALLOWLIST=provider.example
ANIMA_OUTBOUND_ALLOW_HTTP=false
ANIMA_OUTBOUND_ALLOW_PRIVATE=false

ANIMA_HISTORY_LIMIT=20
ANIMA_JSON_LIMIT=10mb
ANIMA_REQUEST_TIMEOUT_MS=30000
ANIMA_LOG_LEVEL=info
